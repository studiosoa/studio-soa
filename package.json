{
  "name": "studio-soa",
  "version": "2.0.0",
  "private": true,
  "description": "Site do Studio Sôa em Next.js, com painel de edição TinaCMS",
  "scripts": {
    "indexar": "node scripts/indexar-conteudo.mjs",
    "predev": "npm run indexar",
    "dev": "next dev",
    "prebuild": "npm run indexar",
    "build": "next build",
    "build:netlify": "npm run indexar && tinacms build && next build",
    "pretina:dev": "npm run indexar",
    "tina:dev": "tinacms dev -c \"next dev\"",
    "tina:build": "tinacms build --local --skip-cloud-checks",
    "start": "next start",
    "lint": "next lint",
    "tipos": "tsc --noEmit"
  },
  "dependencies": {
    "@tinacms/cli": "^4.0.4",
    "leaflet": "^1.9.4",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tinacms": "^3.15.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
